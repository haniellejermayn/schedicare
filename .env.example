NODE_ENV=development
DATABASE_URL=file:./schedicare.db
DEMO_NOW=now

# --- AI runtime -------------------------------------------------------------
# bedrock  = Live Agentic Mode via Claude on Amazon Bedrock (recommended;
#            requires AWS_BEARER_TOKEN_BEDROCK)
# gemini   = Live Agentic Mode via Gemini (requires GEMINI_API_KEY)
# fallback = deterministic agents only (Presentation Resilience Mode)
AI_PROVIDER=bedrock
# Bedrock API key (bearer token) — the AWS SDK reads this variable directly.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_AWS_REGION=ap-southeast-1
# Inference-profile ID (region-prefixed: us./eu./jp./apac. must match region).
# Default workhorse: global.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
GEMINI_API_KEY=
# Recommended: gemini-2.5-flash (free tier, supports function calling).
# gemini-2.5-flash-lite is the lowest-cost option. See docs/GEMINI_SETUP.md.
GEMINI_MODEL=

# --- Google Workspace integrations -------------------------------------------
# google/gmail = live integrations (requires OAuth below)
# simulated    = deterministic local providers (Presentation Resilience Mode)
CALENDAR_PROVIDER=google
MAIL_PROVIDER=gmail
# How often the worker checks known Gmail threads for replies (milliseconds).
GMAIL_POLL_MS=20000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# --- MCP readiness path (see docs/MCP_SETUP.md) -------------------------------
# disabled | http
MCP_TRANSPORT=disabled
GOOGLE_CALENDAR_MCP_URL=
GOOGLE_GMAIL_MCP_URL=

# --- Safety net ---------------------------------------------------------------
# When true, any live-service failure degrades visibly to simulated providers /
# deterministic agents instead of breaking the demo.
FALLBACK_ENABLED=true

# --- Demo tuning (optional) ----------------------------------------------------
# Milliseconds between staged agent-feed steps during the cascade (default 900).
PACING_MS=900
# Keep false for live Gmail demos: only actual inbox replies enter the workflow.
# Set true only with MAIL_PROVIDER=simulated for an offline rehearsal.
AUTO_SIMULATE_REPLIES=false

# --- Live-mode patient emails ---------------------------------------------------
# In Live Agentic Mode every patient needs a REAL inbox you control. Use a
# DIFFERENT account from the clinic Gmail connected through OAuth; replies sent
# from the clinic account are labelled SENT and correctly ignored as outbound.
# The seed gives each patient a plus-alias of this inbox (all aliases deliver to
# one place, while Gmail thread ids keep patient conversations separate).
# Leave empty for Presentation Resilience Mode (simulated mail).
DEMO_PATIENT_EMAIL=
