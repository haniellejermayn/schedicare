{
  "name": "schedicare",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered appointment disruption management for a single outpatient clinic. Agents propose; clinic staff approve.",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "lan": "tsx scripts/lan.ts",
    "build": "next build",
    "start": "next start",
    "worker": "tsx watch worker/bootstrap.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:reset": "tsx scripts/reset.ts",
    "demo:reset:lite": "tsx scripts/reset.ts lite",
    "demo:cascade": "tsx scripts/cascade.ts",
    "test": "vitest run",
    "lint": "next lint --dir app --dir components --dir lib --dir core --dir agents --dir worker --dir integrations --dir sim --dir eval --dir scripts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx eval/run.ts",
    "eval:constraints": "tsx eval/constraintBaseline.ts",
    "db:push": "tsx scripts/migrate-cli.ts",
    "seed": "tsx scripts/setup.ts"
  },
  "dependencies": {
    "@langchain/aws": "^1.4.3",
    "@langchain/core": "^1.2.3",
    "@langchain/google": "^0.2.1",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.36.4",
    "googleapis": "^144.0.0",
    "next": "^14.2.33",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.33",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true
  },
  "overrides": {
    "better-sqlite3": "$better-sqlite3"
  }
}
